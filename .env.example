# Copia este ficheiro para .env e preenche. Nunca ponhas o .env no GitHub.

# Endereço público da app (aparece nos emails)
PUBLIC_URL=http://localhost:3000
PORT=3000

# Pasta onde ficam a base de dados e os ficheiros enviados (fotos, documentos).
# No alojamento, tem de ser um disco permanente.
DATA_DIR=./data

# Em produção: NODE_ENV=production (cookies só por https). Atrás de um proxy (Render, Railway, Nginx): TRUST_PROXY=1
NODE_ENV=development
TRUST_PROXY=0

# Primeiro administrador (criado só quando a base de dados está vazia)
ADMIN_NAME=Nome Apelido
ADMIN_EMAIL=admin@exemplo.pt
ADMIN_PIN=

# Emails (Brevo). Sem chave, os emails ficam registados como "simulado" e não saem.
BREVO_API_KEY=
MAIL_FROM=nao-responder@lpjsports.pt
MAIL_FROM_NAME=C.Arbitragem
MAIL_REPLY_TO=
