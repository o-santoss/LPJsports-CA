# Copia este ficheiro para .env e preenche. Nunca ponhas o .env no GitHub.

# Endereço público da app (aparece nos emails)
PUBLIC_URL=http://localhost:3000
PORT=3000

# Supabase: use the session pooler URL from Connect (port 5432), with SSL.
DATABASE_URL=
SUPABASE_URL=
# Server only. Never use VITE_, NEXT_PUBLIC_ or REACT_APP_ prefixes.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTOS_BUCKET=photos
SUPABASE_DOCUMENTS_BUCKET=documents

# Em produção: NODE_ENV=production (cookies só por https). Atrás de um proxy (Vercel, Nginx): TRUST_PROXY=1
NODE_ENV=development
TRUST_PROXY=0

# Primeiro administrador (criado só quando a base de dados está vazia)
ADMIN_NAME=Nome Apelido
ADMIN_EMAIL=admin@exemplo.pt
ADMIN_PIN=

# Emails (Brevo). Sem chave, os emails ficam registados como "simulado" e não saem.
BREVO_API_KEY=
MAIL_FROM=nao-responder@lpjsports.pt
MAIL_FROM_NAME=C.Arbitragem
MAIL_REPLY_TO=
