{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": { "api/index.js": { "maxDuration": 60 } },
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/[^.]*", "dest": "/index.html" }
  ]
}
