{
  "name": "lpj-base",
  "version": "0.1.0",
  "private": true,
  "description": "Base LPJ Sports: núcleo comum (contas, perfis, notificações, emails, documentos) para as apps da LPJ Sports. Primeira app: C.Arbitragem.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch & node --watch server/index.js",
    "start": "node server/index.js",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test": "node --test test/*.test.js",
    "test:postgres": "node --test test/postgres.test.js"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "author": "LPJ Sports",
  "license": "UNLICENSED",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
