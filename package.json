{
  "name": "lpj-base",
  "version": "0.1.0",
  "private": true,
  "description": "Base LPJ Sports: núcleo comum (contas, perfis, notificações, emails, documentos) para as apps da LPJ Sports. Primeira app: C.Arbitragem.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch & node --disable-warning=ExperimentalWarning --watch server/index.js",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "author": "LPJ Sports",
  "license": "UNLICENSED"
}
